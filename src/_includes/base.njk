<!DOCTYPE html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta http-equiv="X-UA-Compatible" content="ie=edge" />
    {% include "seoHead.njk" %}
    <link rel="shortcut icon" href="/assets/favicon.ico" />
    <link rel="icon" type="image/png" href="/assets/favicon.ico" />
    <link
      href="https://fonts.googleapis.com/css?family=Open+Sans"
      rel="stylesheet"
    />
    <link rel="stylesheet" href="https://use.typekit.net/cta4xsb.css" />
    <link rel="stylesheet" href="/assets/styles/variables.css" />
    <link rel="stylesheet" href="/assets/styles/upTriangleBlock.css" />
    <link rel="stylesheet" href="/assets/styles/downTriangleBlock.css" />
    <link rel="stylesheet" href="/assets/styles/header.css" />
    <link rel="stylesheet" href="/assets/styles/footer.css" />
    <link rel="stylesheet" href="/assets/styles/gallery.css" />
    <link rel="stylesheet" href="/assets/styles/topBlock.css" />
    <link rel="stylesheet" href="/assets/styles/carousel.css" />
    <link rel="stylesheet" href="/assets/styles/textBlock.css" />
    <link rel="stylesheet" href="/assets/styles/imageBlock.css" />
    <link rel="stylesheet" href="/assets/styles/partnerLogo.css" />
    <link rel="stylesheet" href="/assets/styles/twoColumns.css" />
    <link rel="stylesheet" href="/assets/styles/imageAndTextBlock.css" />
    <link rel="stylesheet" href="/assets/styles/linkList.css" />
    <link rel="stylesheet" href="/assets/styles/imageList.css" />
    <link rel="stylesheet" href="/assets/styles/styles.css" />
    <link rel="stylesheet" href="/assets/styles/mediaQueries.css" />
    <link rel="stylesheet" href="/assets/styles/pressRelease.css" />
    <link rel="stylesheet" href="/assets/styles/viewer.css" />
    <link rel="stylesheet" href="/assets/styles/viewerAndTextBlock.css" />
    <link rel="stylesheet" href="/assets/styles/code.css" />
    <link rel="stylesheet" href="/assets/styles/heroBlock.css" />
    <link rel="stylesheet" href="/assets/styles/countdownBlock.css" />
    <link rel="stylesheet" href="/assets/styles/videoEmbedBlock.css" />
    <link rel="stylesheet" href="/assets/styles/tableBlock.css" />
    <link rel="stylesheet" href="/assets/styles/figureBlock.css" />
    <link rel="stylesheet" href="/assets/styles/codeComparisonBlock.css" />
    <link rel="stylesheet" href="/assets/styles/faqBlock.css" />
    <link rel="stylesheet" href="/assets/styles/ctaBlock.css" />
    <!-- Google tag (gtag.js) -->
    <script
      async
      src="https://www.googletagmanager.com/gtag/js?id=UA-41767310-1"
    ></script>
    <script>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());

      gtag("config", "UA-41767310-1");
    </script>
    <script>
      // make sure we are on babylonjs.com
      if (window.location.hostname === "www.babylonjs.com") {
        // add a trailing slash if the browser path doesn't contain a dot
        if (
          !window.location.pathname.endsWith("/") &&
          !window.location.pathname.includes(".")
        ) {
          window.location.pathname += "/";
        }
      }
    </script>
  </head>

  <body>
    <div class="container-header-background"></div>
    <div class="header">
      <div class="container-header">
        <div class="menu-btn">
          <img src="/assets/img/HamburgerIcon.svg" alt="Menu" />
        </div>
        <div class="babylon-logo hidden">
          <a href="/">
            <img src="/assets/img/BabylonIdentity.svg" alt="Babylon.js home" />
          </a>
        </div>
        <a class="download" href="{{ pageData.downloadLink }}"
          ><img src="/assets/img/GithubIcon.svg" alt="Babylon.js on GitHub"
        /></a>
        <div class="header-top-wrapper overflow">
          <div class="header-top">
            <div class="menu">
              <div class="header-ul-wrapper">
                <ul>
                  {% for item in pageData.menu %}{% if item.visible %}{% if item.menuUrl %}
                  <li class="{{ item.menuTitle }} user-select">
                    <a class="{{ item.menuTitle }}" href="{{ item.menuUrl }}"
                      >{{ item.menuTitle }}</a
                    >
                  {% else %}{% if item.children %}
                  </li>

                  <li class="{{ item.menuTitle }} user-select">
                    <a class="{{ item.menuTitle }}">{{ item.menuTitle }}</a>
                  {% else %}
                  </li>

                  <li class="{{ item.menuTitle }} user-select">
                    <a class="{{ item.menuTitle }}" href="/{{ item.root }}">{{ item.menuTitle }}</a>
                  {% endif %}{% endif %}{% endif %}{% endfor %}
                  </li>
                </ul>
              </div>
              <div class="sub-menu">
                {% for item in pageData.menu %}{% if item.children %}
                <ul class="{{ item.menuTitle }} hidden">
                  {% for child in item.children %}{% if child.menuUrl %}
                  <li class="user-select">
                    <a href="{{ child.menuUrl }}" target="{{ child.target }}">{{ child.menuTitle }}</a>
                  </li>
                  {% else %}
                  <li class="user-select">
                    <a href="/{{ item.root }}/{{ child.root }}">{{ child.menuTitle }}</a>
                  </li>
                  {% endif %}{% endfor %}
                </ul>
                {% endif %}{% endfor %}
              </div>
            </div>
          </div>
        </div>
      </div>
    </div>

    <div class="content-container">
      {% if not pageData.seo.hasH1 %}<h1 class="visually-hidden">{{ pageData.seo.heading | escape }}</h1>{% endif %}
      {{ content | safe }}
    </div>
    <footer class="footer">
      <div class="footer-container">
        <div class="footer-left">
          <div class="social-icons">
            {% for social in pageData.socials %}
            <a href="{{ social.link }}" target="_blank"
              ><img src="{{ social.img.url }}" alt="{{ social.img.alt }}"
            /></a>
            {% endfor %}
          </div>
        </div>
        <div class="footer-right">
          {% for item in pageData.footerMenu %}
          <a href="{{ item.url }}" target="_blank">{{ item.menuTitle }}</a>
          {% endfor %}
        </div>
      </div>
    </footer>
    <script src="/assets/js/animation.js"></script>
    <script src="/assets/js/scripts.js"></script>
    <script src="/assets/js/pullRefresh.js"></script>
    {% if pageData.pageConfig.forceFullViewer %}
    <script>
      window.babylonViewerConfig = { forceFull: true };
    </script>
    {% endif %}
    <script type="module" src="/assets/js/viewerLoader.js"></script>
  </body>
</html>
