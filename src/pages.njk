---
pagination:
  data: pages
  size: 1
  alias: pageData
permalink: "{% if pageData.url %}{{ pageData.url }}/index.html{% else %}index.html{% endif %}"
---
{% set content %}
{% for block in pageData.pageConfig.blocks %}
{% renderBlock block %}
{% endfor %}
{% endset %}
{% include pageData.pageConfig.layout or "base.njk" %}
